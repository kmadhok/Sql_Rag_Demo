  {
    "id": "example-2",
    "question": "Which product categories have the most returns?",
    "sql": "SELECT\n    p.category,\n    COUNTIF(t1.returned_at IS NOT NULL) AS number_of_returns,\n    SAFE_DIVIDE(COUNTIF(t1.returned_at IS NOT NULL), COUNT(t1.id)) AS return_rate\n  FROM\n    `bigquery-public-data.thelook_ecommerce.order_items` AS t1\n    INNER JOIN `bigquery-public-data.thelook_ecommerce.products` AS p ON t1.product_id = p.id\n  GROUP BY\n    1\n  ORDER BY\n    number_of_returns DESC",
